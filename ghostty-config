# === Appearance ===
theme = Dark Pastel
font-family = JetBrainsMono Nerd Font
font-size = 12
font-thicken = true
# adjust-cell-height = 10%

# === Window ===
window-padding-x =0
window-padding-y = 0
background-opacity = 0.80
macos-titlebar-style = tabs

# === Cursor & Scrollback ===
cursor-style = block
cursor-style-blink = true
scrollback-limit = 100000
copy-on-select = clipboard

# === macOS Integration ===
macos-option-as-alt = true
quit-after-last-window-closed = true
confirm-close-surface = false

# === Keybinds: Fullscreen & Clear ===
keybind = cmd+shift+enter=toggle_fullscreen
keybind = cmd+k=clear_screen

# === Keybinds: Tab Management ===
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface

# === Keybinds: Native Splits (complements tmux) ===
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+down=goto_split:bottom

# === Keybinds: Global Quick Terminal ===
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.1
